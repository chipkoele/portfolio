# Credentials this workflow needs.
# In n8n these are stored in n8n's own credential store (Credentials menu),
# NOT in this file and NOT in the workflow JSON. Never commit real values.

# Google Gemini API key (aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Gmail SMTP (myaccount.google.com/apppasswords, needs 2-Step Verification)
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your-16-letter-app-password

# Published CSV links of the two sheet tabs (File > Share > Publish to web > CSV)
WEEKLY_DATA_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=...&single=true&output=csv
TARGETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=...&single=true&output=csv
